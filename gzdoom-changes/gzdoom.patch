+/////////////////////////////////////////////////////////////////////////////
+
+// Minecraft passthrough: Minecraft's frame (colour + depth, then hand/HUD) composited into the scene
+
+struct MinecraftWorldUniforms
+{
+	FVector4 RotRow0;
+	FVector4 RotRow1;
+	FVector4 RotRow2;
+	FVector4 TanFov;	// xy: Doom's camera, zw: Minecraft's frame
+	FVector4 DepthNow;	// x, y: linearize Doom's depth, z: map units per block
+	FVector4 DepthMc;	// x: near, y: far, z: reversed Z, w: depth in [0, 1]
+	FVector4 Light;
+	FVector4 CamRel;	// xyz: camera in the cell grid, w: the grid is in use
+	FVector4 WorldRow0;
+	FVector4 WorldRow1;
+	FVector4 WorldRow2;
+	FVector2 Scale;
+	FVector2 Offset;
+
+	static std::vector<UniformFieldDesc> Desc()
+	{
+		return
+		{
+			{ "RotRow0", UniformType::Vec4, offsetof(MinecraftWorldUniforms, RotRow0) },
+			{ "RotRow1", UniformType::Vec4, offsetof(MinecraftWorldUniforms, RotRow1) },
+			{ "RotRow2", UniformType::Vec4, offsetof(MinecraftWorldUniforms, RotRow2) },
+			{ "TanFov", UniformType::Vec4, offsetof(MinecraftWorldUniforms, TanFov) },
+			{ "DepthNow", UniformType::Vec4, offsetof(MinecraftWorldUniforms, DepthNow) },
+			{ "DepthMc", UniformType::Vec4, offsetof(MinecraftWorldUniforms, DepthMc) },
+			{ "Light", UniformType::Vec4, offsetof(MinecraftWorldUniforms, Light) },
+			{ "CamRel", UniformType::Vec4, offsetof(MinecraftWorldUniforms, CamRel) },
+			{ "WorldRow0", UniformType::Vec4, offsetof(MinecraftWorldUniforms, WorldRow0) },
+			{ "WorldRow1", UniformType::Vec4, offsetof(MinecraftWorldUniforms, WorldRow1) },
+			{ "WorldRow2", UniformType::Vec4, offsetof(MinecraftWorldUniforms, WorldRow2) },
+			{ "Scale", UniformType::Vec2, offsetof(MinecraftWorldUniforms, Scale) },
+			{ "Offset", UniformType::Vec2, offsetof(MinecraftWorldUniforms, Offset) }
+		};
+	}
+};
+
+class PPMinecraft
+{
+public:
+	void RenderWorld(PPRenderState *renderstate);
+	void RenderOverlay(PPRenderState *renderstate);
+
+private:
+	bool Update();
+
+	PPShader World = { "shaders/pp/mcworld.fp", "", MinecraftWorldUniforms::Desc() };
+	PPShader WorldMS = { "shaders/pp/mcworld.fp", "#define MULTISAMPLE\n", MinecraftWorldUniforms::Desc() };
+	PPShader Overlay = { "shaders/pp/mcoverlay.fp", "", {} };
+	PPTexture ColorTexture;
+	PPTexture DepthTexture;
+	PPTexture OverlayTexture;
+	PPTexture GridTexture;
+	uint64_t GridSerial = ~0ull;
+	bool GridUsed = false;
+	uint64_t Serial = 0;
+	bool Active = false;
+	bool DrawWorld = true, DrawOverlay = true;
+	MinecraftWorldUniforms Uniforms;
+};
+
