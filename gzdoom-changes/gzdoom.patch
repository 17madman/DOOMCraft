+//==========================================================================
+//
+// Minecraft passthrough
+//
+//==========================================================================
+
+bool PPMinecraft::Update()
+{
+	McLayers layers;
+	Active = MCBridge_GetLayers(layers);
+	if (!Active)
+		return false;
+
+	if (layers.serial != Serial || ColorTexture.Width != layers.width || ColorTexture.Height != layers.height)
+	{
+		// the buffers stay valid until the next MCBridge_GetLayers; the backend copies them on first use
+		auto borrow = [](const void *p) { return std::shared_ptr<void>(const_cast<void *>(p), [](void *) {}); };
+		ColorTexture = PPTexture(layers.width, layers.height, PixelFormat::Rgba8, borrow(layers.color));
+		DepthTexture = PPTexture(layers.width, layers.height, PixelFormat::R32f, borrow(layers.depth));
+		OverlayTexture = PPTexture(layers.width, layers.height, PixelFormat::Rgba8, borrow(layers.overlay));
+		Serial = layers.serial;
+	}
+
+	Uniforms.RotRow0 = FVector4(layers.rot[0][0], layers.rot[0][1], layers.rot[0][2], layers.rot[0][3]);
+	Uniforms.RotRow1 = FVector4(layers.rot[1][0], layers.rot[1][1], layers.rot[1][2], layers.rot[1][3]);
+	Uniforms.RotRow2 = FVector4(layers.rot[2][0], layers.rot[2][1], layers.rot[2][2], layers.rot[2][3]);
+	Uniforms.TanFov = FVector4(layers.tanNow[0], layers.tanNow[1], layers.tanMc[0], layers.tanMc[1]);
+	Uniforms.DepthNow = FVector4(1.0f / screen->GetZFar() - 1.0f / screen->GetZNear(), max(1.0f / screen->GetZNear(), 1.e-8f), 32.0f, 0.0f);
+	Uniforms.DepthMc = FVector4(layers.nearPlane, layers.farPlane, layers.reversedZ ? 1.0f : 0.0f, layers.zeroToOne ? 1.0f : 0.0f);
+	Uniforms.Light = FVector4(layers.light, 0.0f, 0.0f, 0.0f);
+
+	GridUsed = layers.gridUsed;
+	if (GridUsed && layers.gridSerial != GridSerial)
+	{
+		auto borrow = [](const void *p) { return std::shared_ptr<void>(const_cast<void *>(p), [](void *) {}); };
+		GridTexture = PPTexture(layers.gridSide, layers.gridSide, PixelFormat::Rgba8, borrow(layers.grid));
+		GridSerial = layers.gridSerial;
+	}
+	Uniforms.CamRel = FVector4(layers.camInGrid[0], layers.camInGrid[1], layers.camInGrid[2], GridUsed && layers.anyMined ? 1.0f : 0.0f);
+	Uniforms.Light.Y = GridUsed ? 1.0f : 0.0f;
+	Uniforms.Light.Z = layers.sectorLight;
+	Uniforms.WorldRow0 = FVector4(layers.viewToWorld[0][0], layers.viewToWorld[0][1], layers.viewToWorld[0][2], 0.0f);
+	Uniforms.WorldRow1 = FVector4(layers.viewToWorld[1][0], layers.viewToWorld[1][1], layers.viewToWorld[1][2], 0.0f);
+	Uniforms.WorldRow2 = FVector4(layers.viewToWorld[2][0], layers.viewToWorld[2][1], layers.viewToWorld[2][2], 0.0f);
+	Uniforms.Scale = screen->SceneScale();
+	Uniforms.Offset = screen->SceneOffset();
+	DrawWorld = layers.drawWorld;
+	DrawOverlay = layers.drawOverlay;
+	return true;
+}
+
+void PPMinecraft::RenderWorld(PPRenderState *renderstate)
+{
+	if (!Update() || !DrawWorld)
+		return;
+
+	renderstate->PushGroup("minecraft world");
+	renderstate->Clear();
+	renderstate->Shader = gl_multisample > 1 ? &WorldMS : &World;
+	renderstate->Uniforms.Set(Uniforms);
+	renderstate->Viewport = screen->mSceneViewport;
+	renderstate->SetInputCurrent(0);
+	renderstate->SetInputSceneDepth(1);
+	renderstate->SetInputTexture(2, &ColorTexture, PPFilterMode::Linear);
+	renderstate->SetInputTexture(3, &DepthTexture);
+	renderstate->SetInputTexture(4, GridUsed ? &GridTexture : &DepthTexture);
+	renderstate->SetOutputNext();
+	renderstate->SetNoBlend();
+	renderstate->Draw();
+	renderstate->PopGroup();
+}
+
+void PPMinecraft::RenderOverlay(PPRenderState *renderstate)
+{
+	if (!Active || !DrawOverlay)
+		return;
+
+	renderstate->PushGroup("minecraft overlay");
+	renderstate->Clear();
+	renderstate->Shader = &Overlay;
+	renderstate->Viewport = screen->mSceneViewport;
+	renderstate->SetInputCurrent(0);
+	renderstate->SetInputTexture(1, &OverlayTexture, PPFilterMode::Linear);
+	renderstate->SetOutputNext();
+	renderstate->SetNoBlend();
+	renderstate->Draw();
+	renderstate->PopGroup();
+}
